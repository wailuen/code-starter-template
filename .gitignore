# Secrets — keep only .env.example under version control
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
.npmrc
.pypirc
.aws/
service-account*.json
*credentials*.json
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
.netrc
.git-credentials
.htpasswd
kubeconfig
.docker/config.json
*.tfstate*
.terraform/
*.tfvars
.kube/
*.p8
*.jks
.dev.vars
.pgpass

# Local deploy cache — the deployed revision comes from deploy_check_command, not this file
deploy/.last-deployed

# Prototype screen-check screenshots — local only (`.harness/phases/prototype.md` step 5)
workspaces/*/prototype/.screenshots/

# Harness runtime state (review-round state, launch ledger) — created on first use
.claude/learning/

# Generated Codex adapters — each checkout generates its own with
# `node .harness/bin/check-adapters.mjs --write --codex` (see .harness/adapters/codex.md)
.agents/*
.codex/*

# Per-user Claude Code files
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.local.md

# Worktrees must be siblings of the repo, never nested (see .claude/rules/worktree-isolation.md)
.claude/worktrees/

# OS / editor noise
.DS_Store

# Per-session notes written by /wrapup (local to this checkout)
.session-notes

# Common dependency and build caches (add your language's own in the project)
node_modules/
__pycache__/
*.keystore
firebase-adminsdk-*.json
